{
  "name": "lit-ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "vite",
    "build": "vite build && npm run build:lib",
    "build:lib": "vite build --config vite.lib.config.js && tsc",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p . && tsc -p test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@statelyai/inspect": "^0.7.2",
    "lit": "^3.3.3",
    "xstate": "^6.0.0-alpha.71"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-istanbul": "^5.0.5",
    "@web/rollup-plugin-html": "^4.0.0",
    "playwright": "^1.64.1",
    "rollup-plugin-node-externals": "^9.0.1",
    "tinyglobby": "^0.2.17",
    "tslib": "^2.9.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.5"
  }
}
